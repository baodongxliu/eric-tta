rules_version = '2';

// Security rules for the Eric Table Tennis member app.
//
// Roles:
//   - "student": can only read/edit their own data.
//   - "admin":   can read/write everything (logged purchases, lessons, etc.).
// Admin status is bootstrapped manually in the Firestore console
// (set /users/{uid}.role = "admin").

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && userDoc().role == "admin";
    }

    function userFamilyGroupId() {
      return userDoc().familyGroupId;
    }

    // ─── /users/{uid} ────────────────────────────────────────────
    match /users/{uid} {
      // Read your own; admins read all.
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());

      // Self-signup: must be the same uid, default role is "student",
      // and admins can't be self-promoted.
      allow create: if isSignedIn()
                    && request.auth.uid == uid
                    && request.resource.data.role == "student";

      // Self-update: only allowed to change displayName (not role/family).
      allow update: if isSignedIn() && request.auth.uid == uid
                    && request.resource.data.role == resource.data.role
                    && request.resource.data.familyGroupId == resource.data.familyGroupId
                    && request.resource.data.email == resource.data.email;

      // Admin can do anything.
      allow update, delete: if isAdmin();
    }

    // ─── /familyGroups/{id} ──────────────────────────────────────
    match /familyGroups/{id} {
      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.memberUids.hasAny([request.auth.uid]));
      allow create, update, delete: if isAdmin();
    }

    // ─── /memberships/{id} ───────────────────────────────────────
    // Family memberships carry an immutable `memberUidsAtCreation` snapshot
    // so former members retain history visibility after leaving the family
    // (or after the family is dissolved). Family-membership creates MUST
    // atomically increment the owning group's familyMembershipCount —
    // that's how commitFamilyGroupDissolve detects concurrent attaches.
    // Console writes or stale code that skip the increment fail here.
    match /memberships/{id} {
      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.ownerType == "student"
                      && resource.data.ownerId == request.auth.uid)
                  || (isSignedIn() && resource.data.ownerType == "family"
                      && (resource.data.ownerId == userFamilyGroupId()
                          || (resource.data.memberUidsAtCreation is list
                              && resource.data.memberUidsAtCreation.hasAny([request.auth.uid]))));

      // .get('familyMembershipCount', 0) treats a missing field as 0, so
      // legacy familyGroups docs that predate the counter still pass when
      // a fresh write bumps from 0→1. Newly-created groups initialize the
      // field to 0 in commitFamilyGroupCreate. No backfill required.
      allow create: if isAdmin() && (
        request.resource.data.ownerType == "student"
        || (
          request.resource.data.ownerType == "family"
          && exists(/databases/$(database)/documents/familyGroups/$(request.resource.data.ownerId))
          && getAfter(/databases/$(database)/documents/familyGroups/$(request.resource.data.ownerId)).data.get('familyMembershipCount', 0)
             == get(/databases/$(database)/documents/familyGroups/$(request.resource.data.ownerId)).data.get('familyMembershipCount', 0) + 1
        )
      );

      allow update, delete: if isAdmin();
    }

    // ─── /lessonPurchases/{id} ───────────────────────────────────
    match /lessonPurchases/{id} {
      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.studentId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    // ─── /lessonsUsed/{id} ───────────────────────────────────────
    match /lessonsUsed/{id} {
      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.studentId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }
  }
}
